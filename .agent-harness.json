  "roles": [
    "producer-orchestrator",
    "score-captain",
    "lyric-captain",
    "meditation-captain",
    "suno-craft",
    "taste-ar",
    "browser-operator",
    "qa-listener",
    "dam-release",
    "visual-director",
    "packaging-engineer",
    "independent-reviewer"
  ],
  "cli_adapters": {
    "claude": [".claude/agents/producer-orchestrator.md", ".claude/agents/score-captain.md", ".claude/agents/taste-ar.md"],
